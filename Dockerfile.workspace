FROM python:3.12-slim
WORKDIR /app
COPY requirements-workspace.txt .
RUN pip install --no-cache-dir -r requirements-workspace.txt
COPY . .
RUN useradd -m studio && mkdir -p data && chown -R studio data
USER studio
CMD ["python", "-m", "uvicorn", "backend.app.workspace:app", "--host", "0.0.0.0", "--port", "8012"]
